{
  // markdown-review プラグイン共通の markdownlint 設定。
  // 文書種別（technical / blog）に依らず構造チェックはこの 1 つを使う。
  "config": {
    "MD013": false,
    "MD033": {
      "allowed_elements": ["br"]
    },
    "MD025": {
      "front_matter_title": ""
    },
    // 見出しの重複は「同じ親を持つ兄弟同士」だけを検査する。
    // 技術文書・翻訳記事では、実装小節の「まとめ」「概要」と記事末尾の
    // 「まとめ」のように、階層の異なる同名見出しが正当に共存する。
    // これを重複扱いして本文（訳文）の書き換えを迫らないための緩和。
    "MD024": {
      "siblings_only": true
    }
  }
}
